# ==============================================================================
# LOOM AI - Environment Variables
# Copy this file to .env.local and fill in your actual credentials.
# Do not commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model Inference Configuration
# ------------------------------------------------------------------------------
# URL of your model inference endpoint (OpenAI, MLX, vLLM, or Hugging Face)
# For local MLX server on Apple Silicon: http://localhost:8080/v1/chat/completions
MODEL_API_URL=http://localhost:8080/v1/chat/completions

# API key for the model endpoint (leave blank if running local MLX server without auth)
MODEL_API_KEY=

# ------------------------------------------------------------------------------
# 2. Supabase Authentication & PostgreSQL Database
# ------------------------------------------------------------------------------
# Find these in your Supabase Project Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase service role key (keep strictly server-side, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
