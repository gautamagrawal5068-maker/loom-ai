# LOOM AI - Environment Variables
# Copy this file to .env.local and fill in your values

# The URL of your model's inference API endpoint
# Example: https://api-inference.huggingface.co/models/your-model
# or a custom endpoint like https://your-server.com/v1/chat/completions
MODEL_API_URL=

# Your API key for authenticating with the model endpoint
MODEL_API_KEY=
