# LOOM AI - Environment Variables Template
# Copy these values into your hosting provider's Environment Variables dashboard (e.g., Vercel)

# Google Gemini Model Configuration
MODEL_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent
MODEL_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-3.8-flash

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# RewriteAI Humanizer API Configuration (Used for Tapestry Model)
REWRITEAI_API_KEY=your_rewriteai_api_key_here
